{
  "name": "cynbit-smart-project-assistant",
  "version": "1.0.0",
  "description": "Smart Project Inquiry Wizard & Requirement Scoping System for Cynbit Technologies",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "mern",
    "cynbit",
    "project-assistant",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Full Stack Developer Candidate",
  "license": "MIT"
}
